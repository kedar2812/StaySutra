# Database
DATABASE_URL=

# Dashboard sessions are database-backed; no auth secret is needed.
# First owner account, created by `docker compose run --rm seed` (or npm run db:seed).
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=

# Calendar sync (iCal). Runs inside the app; the secret guards the manual endpoint.
CALENDAR_SYNC_MINUTES=15
CRON_SECRET=

# Storage
UPLOAD_DIR=/var/staysutra/uploads

# Public
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Email
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=

# Spam
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics
NEXT_PUBLIC_GA4_ID=
